<?xml version="1.0"?>
<model>
  <name>hege_rover</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Hege GPS Navigation</name>
  </author>

  <description>
    The measured HEGE Ackermann field rover, for PX4 SITL on Gazebo Harmonic.

    model.sdf is generated from src/hege_description/urdf/hege.urdf.xacro with
    drive:=px4 by ../../scripts/generate_hege_model.sh, so it is not committed.
    Edit the xacro, not the SDF.
  </description>
</model>
