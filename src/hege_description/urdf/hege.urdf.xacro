<?xml version="1.0"?>
<robot name="hege" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- How the rover is driven in Gazebo.
         planar        - libgazebo_ros_planar_move drives base_link directly
                         from /cmd_vel. Simple and reliable, good for checking
                         the model and exercising the sensors, but it is NOT
                         Ackermann: it will happily spin in place and strafe,
                         so it cannot be used to judge whether a path is
                         actually drivable.
         ros2_control  - gazebo_ros2_control + ackermann_steering_controller.
                         Real Ackermann kinematics, and the path to the real
                         robot, but currently held up by a controller bug that
                         makes the rover creep at 1 m/s on startup.
         gz            - Gazebo HARMONIC, the same Ackermann controller through
                         gz_ros2_control. This is the mode spawn_hege.launch.py
                         uses and the one to develop against; the two Classic
                         modes above are kept for reference and for a machine
                         that still has Gazebo Classic installed.
         px4           - Gazebo Harmonic, driven by PX4 SITL rather than by
                         ROS. Nothing in this mode talks to ROS at all: PX4's
                         gz_bridge reads the sensors and writes the wheel and
                         steering joints over gz-transport, and ROS only sees
                         the vehicle through the uXRCE-DDS link and
                         hege_px4_sensors. See docs/px4_sitl.md.

       Classic and Harmonic CANNOT be installed on the same machine: their
       Debian packages both ship /usr/bin/gz and conflict outright. That is why
       gz exists at all - PX4 SITL requires Harmonic, so the ROS-driven
       simulation had to move there too. See docs/gazebo_harmonic.md.

       What every mode has in common, and what makes hege_localization and
       hege_navigation run unchanged against all of them: /imu/data, /gps/fix
       and the Ackermann controller's odometry topic. -->
  <xacro:arg name="drive" default="planar"/>
  <xacro:property name="drive" value="$(arg drive)"/>

  <!-- ============ SENSOR NOISE ============ -->
  <!-- Edited here rather than passed in at launch. The workspace is built
       with symlink install, so a change takes effect on the next launch with
       no rebuild. -->

  <!-- GPS horizontal standard deviation, metres. Vertical is derived at twice
       this, as it runs on any GNSS receiver.
         0.02  RTK fixed
         0.4   RTK float
         2.0   single-point solution
       The upper two are the Goal 2 robustness cases: raise this, run the same
       route, and read the error off the localization monitor. -->
  <xacro:property name="gps_noise" value="0.02"/>

  <!-- UNITS TRAP. Gazebo Classic's <gps> sensor takes horizontal noise in
       METRES. Gazebo Harmonic's <navsat> sensor does not: gz-sensors8 applies
       the value straight to Latitude().Degree() and Longitude().Degree(), so
       it is in DEGREES. Feeding gps_noise to it unconverted asks for 0.02
       degrees of error, which is 2.2 km - and nothing warns, the fix just
       becomes noise. The gz branch below divides by this; the Classic branch
       must not.

       Found by Oguzhan Enes Isik in oguzissik/hege_gps_navigation.

       A consequence worth knowing: the same ANGULAR noise on both axes is not
       the same METRIC noise, because one degree of longitude is cos(latitude)
       fewer metres than one of latitude. At this site that makes the east
       error about 0.61 of the north one. sim_gps_covariance.py carries that
       into the covariance it publishes. -->
  <xacro:property name="metres_per_latitude_degree" value="111195.0"/>

  <!-- Gyro and accelerometer bias. A real MEMS IMU's dominant error is not
       white noise but a bias drawn at startup that then wanders, and that is
       what makes dead reckoning fall apart. Leaving these at zero, as this
       model did until now, hands the filter an IMU better than any that
       exists. Raising the local EKF's worst error from 0.93 m to 3.39 m over
       the same route is the honest number, not a regression. -->
  <xacro:property name="imu_gyro_bias"  value="7.5e-6"/>
  <xacro:property name="imu_accel_bias" value="0.05"/>

  <!-- White noise per sample. Datasheets quote noise DENSITY, per root-hertz;
       convert with stddev = density * sqrt(rate) before putting a number
       here. -->
  <xacro:property name="imu_gyro_noise"  value="2e-4"/>
  <xacro:property name="imu_accel_noise" value="1.7e-2"/>

  <!-- ============ MEASURED HEGE DIMENSIONS ============ -->
  <!-- Body. base_link sits at the underside of the chassis, body_z_offset above
       it is the box centre, and base_z is how high base_link rides above the
       ground. -->
  <xacro:property name="base_length"   value="2.2"/>
  <xacro:property name="base_width"    value="1.4"/>
  <xacro:property name="base_height"   value="0.8"/>
  <!-- Mass. The real machine is 1300 kg. Wheel and knuckle masses are
       estimates for tractor-style wheels; the chassis takes whatever is left,
       so the total always comes out at total_mass no matter which of these is
       edited. -->
  <xacro:property name="total_mass"        value="1300.0"/>
  <xacro:property name="rear_wheel_mass"   value="80.0"/>
  <xacro:property name="front_wheel_mass"  value="45.0"/>
  <xacro:property name="steer_link_mass"   value="15.0"/>
  <xacro:property name="sensor_mass"       value="0.05"/>
  <xacro:property name="base_mass"
    value="${total_mass - 2*rear_wheel_mass - 2*front_wheel_mass
                        - 2*steer_link_mass - 2*sensor_mass}"/>

  <!-- Weight distribution, stated as the share of static load carried by the
       front axle. Tractor-like machines sit back on the rear axle, which is
       also why the rear wheels are the larger pair. 0.4 means 40% front,
       60% rear.

       The chassis centre of mass is then placed wherever it has to be for the
       whole vehicle to balance that way, given that the wheels and knuckles
       sit at fixed positions and carry their own weight. Derived rather than
       typed so the two cannot drift apart. -->
  <xacro:property name="front_axle_load" value="0.4"/>
  <xacro:property name="com_x_target" value="${wheelbase*(front_axle_load - 0.5)}"/>
  <xacro:property name="base_com_x"
    value="${(total_mass*com_x_target
              - 2*(front_wheel_mass + steer_link_mass)*(wheelbase/2)
              + 2*rear_wheel_mass*(wheelbase/2)) / base_mass}"/>

  <!-- Centre of mass height above base_link. The body box spans 0 to 0.8, but
       the heavy parts of a machine like this - drivetrain, batteries - sit low,
       so the centre of mass is placed below the box's geometric centre. It
       matters for rollover behaviour on slopes. -->
  <xacro:property name="base_com_z" value="0.25"/>
  <xacro:property name="body_z_offset" value="0.4"/>
  <xacro:property name="base_z"        value="1.10"/>

  <!-- Front and rear wheels are DIFFERENT sizes on Hege: 28 cm front, 40 cm
       rear. Everything downstream has to respect that - the axle heights below
       are derived from each radius so both pairs touch the ground, and
       controllers.yaml carries the two radii separately. -->
  <xacro:property name="front_wheel_radius" value="0.28"/>
  <xacro:property name="rear_wheel_radius"  value="0.40"/>
  <xacro:property name="wheel_width"        value="0.2"/>
  
  <!-- Front and rear tracks are equal; the wheel sizes are what differ. -->
  <xacro:property name="wheelbase"   value="1.90"/>
  <xacro:property name="front_track" value="1.55"/>
  <xacro:property name="rear_track"  value="1.55"/>

  <!-- Minimum turning radius is wheelbase/tan(max_steer), so at 1.90 m
       wheelbase this sets it to 2.71 m. Nav2's controller tuning depends on
       it - though Nav2 is held to 6.0 m, which is what the rover was measured
       to actually achieve once tyre slip is in play. -->
  <xacro:property name="max_steer" value="0.610865238"/>   <!-- 35 deg -->

  <!-- Axle heights relative to base_link, derived so each wheel rests on the
       ground given its own radius. -->
  <xacro:property name="front_axle_z" value="${front_wheel_radius - base_z}"/>
  <xacro:property name="rear_axle_z"  value="${rear_wheel_radius - base_z}"/>

  <!-- ============ MEASURED SENSOR HEIGHTS ============ -->
  <!-- Measured on the real Hege as heights ABOVE THE GROUND, in metres:
         1.10  base_link   (= base_z above)
         1.20  imu_link
         1.30  gps_link
       Stated here in the same frame they were measured in, and converted to
       the base_link-relative offsets the joints need, so a re-measure only
       ever touches the number next to its own name. The lever arms that come
       out of this are 0.10 m for the IMU and 0.20 m for the GPS antenna;
       robot_localization reads base_link->gps_link straight off TF, so these
       are the numbers navsat_transform uses to take the antenna offset out of
       the fix.

       Worth knowing when reading the model: the chassis box spans 1.10 to
       1.90 m above the ground, so both frames sit INSIDE the body volume and
       neither is visible from outside in RViz or Gazebo. That is what was
       measured, and it is only the visual box that disagrees - the frames
       themselves are where the hardware is. -->
  <xacro:property name="imu_height" value="1.20"/>
  <xacro:property name="gps_height" value="1.30"/>
  <xacro:property name="imu_z" value="${round(imu_height - base_z, 6)}"/>
  <xacro:property name="gps_z" value="${round(gps_height - base_z, 6)}"/>

  <!-- ============ INERTIA HELPERS ============ -->
  <!-- Hand-written inertia tensors that disagree with the link's mass and
       geometry are the usual cause of ODE blowing up into NaN. These compute
       the real thing so the numbers stay consistent when dimensions change. -->
  <xacro:macro name="box_inertia" params="m x y z cx:=0 cy:=0 cz:=0">
    <inertial>
      <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder spun about its local z axis, which is how the wheels are built. -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12.0}" iyz="0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Contact/friction tuning shared by all four wheels. Without explicit kp/kd
       the wheels sink into the ground plane and jitter. -->
  <xacro:macro name="wheel_surface" params="link">
    <gazebo reference="${link}">
      <!-- Friction. Tractor tyres on soil, and this is the knob behind the
           rover turning less sharply than commanded. -->
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <!-- Contact stiffness and damping, scaled with the vehicle. At the
           1e6 that suited a 15 kg model, 1300 kg pushes the wheels into the
           ground far enough to change the effective radius and therefore the
           odometry. -->
      <kp>10000000.0</kp>
      <kd>10000.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <link name="base_footprint">
    <!-- Massless everywhere except px4 mode. There the base_joint below is
         preserved through SDF conversion, which leaves base_footprint as a
         real root link, and gz-sim wants a root link to have an inertia. It is
         1e-4 kg against 1300 kg, so it changes neither the total mass nor the
         centre of mass in any way that survives rounding. -->
    <xacro:if value="${drive == 'px4'}">
      <inertial>
        <mass value="1e-4"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </xacro:if>
  </link>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="orange"><color rgba="1 0.5 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"
                       cx="${base_com_x}" cz="${base_com_z}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_z}"/>
  </joint>

  <!-- ============ REAR (driven) WHEELS ============ -->
  <xacro:macro name="rear_wheel" params="prefix y_sign">
    <link name="${prefix}_rear_wheel">
      <visual>
        <geometry><cylinder radius="${rear_wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${rear_wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${rear_wheel_mass}" r="${rear_wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${prefix}_rear_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_rear_wheel"/>
      <!-- rpy is NEGATIVE 90 about x. With +90 the joint's z axis lands on -y,
           which makes a positive wheel velocity drive the rover backwards.
           Measured: commanded +1.5 m/s moved the model to world x = -7.4. -->
      <origin xyz="${-wheelbase/2} ${y_sign*rear_track/2} ${rear_axle_z}" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:rear_wheel prefix="left"  y_sign=" 1"/>
  <xacro:rear_wheel prefix="right" y_sign="-1"/>
  <xacro:wheel_surface link="left_rear_wheel"/>
  <xacro:wheel_surface link="right_rear_wheel"/>

  <!-- ============ FRONT (steered) WHEELS ============ -->
  <!-- Each front side needs TWO joints: a revolute steer + a continuous roll -->
  <xacro:macro name="front_wheel" params="prefix y_sign">
    <!-- Steering hinge link (small, no visual mass) -->
    <link name="${prefix}_steer_link">
      <!-- Deliberately heavier than the real steering knuckle, and scaled with
           the wheel it carries. A large mass ratio across a joint is something
           ODE cannot solve stably - it diverges to NaN within a few steps. -->
      <inertial>
        <mass value="${steer_link_mass}"/>
        <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/>
      </inertial>
    </link>
    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child  link="${prefix}_steer_link"/>
      <origin xyz="${wheelbase/2} ${y_sign*front_track/2} ${front_axle_z}"/>
      <axis xyz="0 0 1"/>
      <!-- Effort scaled with the vehicle. 100 Nm, sized for the old 15 kg
           placeholder, cannot turn the front axle of a 1300 kg machine against
           tyre scrub; the steering simply would not reach its commanded angle.
           Velocity limited to roughly lock to lock in a second and a half,
           which is about what a real steering actuator manages. -->
      <limit lower="${-max_steer}" upper="${max_steer}" effort="8000" velocity="0.8"/>
    </joint>

    <!-- Actual rolling wheel attached to the steer link -->
    <link name="${prefix}_front_wheel">
      <visual>
        <geometry><cylinder radius="${front_wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${front_wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${front_wheel_mass}" r="${front_wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${prefix}_front_wheel_joint" type="continuous">
      <parent link="${prefix}_steer_link"/>
      <child  link="${prefix}_front_wheel"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:front_wheel prefix="left"  y_sign=" 1"/>
  <xacro:front_wheel prefix="right" y_sign="-1"/>
  <xacro:wheel_surface link="left_front_wheel"/>
  <xacro:wheel_surface link="right_front_wheel"/>

  <!-- ============ SENSOR FRAMES ============ -->
  <!-- Small inertials keep Gazebo from warning about massless links. Both are
       attached by fixed joints, so SDF conversion lumps them into base_link;
       the sensors still report in their own frame_name, which
       robot_state_publisher provides from the URDF. -->

  <!-- IMU, 1.20 m above the ground -->
  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 ${imu_z}" rpy="0 0 0"/>
  </joint>

  <!-- GPS antenna, 1.30 m above the ground -->
  <link name="gps_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="gps_link"/>
    <origin xyz="0 0 ${gps_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============ SENSORS, GAZEBO CLASSIC ============ -->
  <!-- Wrapped rather than re-indented so the diff against the working
       simulation stays readable. Both Harmonic modes replace these wholesale
       further down: the plugin names, the sensor types and the consumer are
       all different. The topic names, /imu/data and /gps/fix, are the one
       thing that stays the same in every mode, which is what lets
       hege_localization run unchanged against any of them. -->
  <xacro:if value="${drive in ['planar', 'ros2_control']}">

  <!-- ============ IMU SENSOR ============ -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <!-- false = report orientation in the world ENU frame (REP-145).
             Leaving this at its default of true reports orientation relative
             to wherever the robot happened to start, which breaks the
             absolute-heading input the global EKF needs. -->
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============ GPS SENSOR ============ -->
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="gps">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <gps>
        <position_sensing>
          <horizontal>
            <noise type="gaussian"><mean>0.0</mean><stddev>${gps_noise}</stddev></noise>
          </horizontal>
          <!-- Vertical error runs about twice the horizontal on any GNSS
               receiver, so it is derived rather than set separately. -->
          <vertical>
            <noise type="gaussian"><mean>0.0</mean><stddev>${gps_noise * 2}</stddev></noise>
          </vertical>
        </position_sensing>
      </gps>
      <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=gps/fix</remapping>
        </ros>
        <frame_name>gps_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  </xacro:if>

  <!-- ============ SENSORS, GAZEBO HARMONIC (gz mode) ============ -->
  <!-- Same physical sensors, same noise numbers, same ROS topics. Three things
       are different from the Classic blocks above:

       1. No ROS plugin. A gz sensor publishes on gz-transport and
          ros_gz_bridge carries it into ROS, so the bridge in
          spawn_hege.launch.py is what decides the ROS type and has to agree
          with the <topic> set here.
       2. <topic> replaces the plugin's remapping. Without it the sensor would
          publish under its long /world/.../sensor/... path and the bridge
          would have to name that instead.
       3. The GPS sensor type is called navsat, not gps, and the world has to
          load gz-sim-navsat-system and gz-sim-imu-system or neither sensor
          produces anything.

       The px4 mode below uses gz sensors too, but attaches them to base_link
       under names PX4 hardcodes, and never bridges them into ROS at all. -->
  <xacro:if value="${drive == 'gz'}">

    <!-- SDF conversion lumps a fixed joint's child into its parent, which
         would move both sensors onto base_link and publish their readings
         stamped with that frame. navsat_transform reads the antenna offset
         off base_link->gps_link in TF, so it would then take out an offset of
         zero and place every fix 0.20 m low. -->
    <gazebo reference="imu_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="gps_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <topic>/imu/data</topic>
        <always_on>true</always_on>
        <update_rate>100.0</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- Vertical error at twice the horizontal, same rule as the Classic
         receiver, so gps_noise up at the top still drives both simulators. -->
    <gazebo reference="gps_link">
      <sensor name="gps_sensor" type="navsat">
        <topic>/gps/fix</topic>
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>
        <navsat>
          <position_sensing>
            <!-- DEGREES here, not metres - see metres_per_latitude_degree at
                 the top of this file. The Classic sensor above takes the same
                 quantity in metres, which is exactly what makes this easy to
                 get wrong. -->
            <horizontal>
              <noise type="gaussian"><mean>0.0</mean><stddev>${gps_noise / metres_per_latitude_degree}</stddev></noise>
            </horizontal>
            <!-- Vertical noise IS in metres, in both simulators. -->
            <vertical>
              <noise type="gaussian"><mean>0.0</mean><stddev>${gps_noise * 2}</stddev></noise>
            </vertical>
          </position_sensing>
        </navsat>
      </sensor>
    </gazebo>

    <!-- Ground truth, for scoring the estimates against the real answer.
         Replaces the Classic world's gazebo_ros_state plugin and its
         /model_states. Nothing in the navigation stack may consume this.

         tf_topic is deliberately pointed at a topic the bridge does not carry:
         this plugin will happily publish odom->base_footprint, and that edge
         belongs to robot_localization's local EKF. Leaving it bridged puts two
         publishers on one TF edge, which does not fail loudly - the transform
         just flickers between two answers. -->
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/ground_truth/odom</odom_topic>
        <tf_topic>/ground_truth/tf_unused</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:if>


  <!-- ============ PLANAR DRIVE (keyboard / teleop) ============ -->
  <xacro:if value="${drive == 'planar'}">
    <gazebo>
      <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/</namespace></ros>
        <update_rate>50</update_rate>
        <publish_rate>50</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <covariance_x>0.0001</covariance_x>
        <covariance_y>0.0001</covariance_y>
        <covariance_yaw>0.01</covariance_yaw>
      </plugin>
    </gazebo>

    <!-- joint_state_broadcaster is not running in this mode, so the wheel and
         steer joints would otherwise have no TF at all. -->
    <gazebo>
      <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=joint_states</remapping>
        </ros>
        <update_rate>50</update_rate>
        <joint_name>left_rear_wheel_joint</joint_name>
        <joint_name>right_rear_wheel_joint</joint_name>
        <joint_name>left_steer_joint</joint_name>
        <joint_name>right_steer_joint</joint_name>
        <joint_name>left_front_wheel_joint</joint_name>
        <joint_name>right_front_wheel_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="${drive in ['ros2_control', 'gz']}">
    <!-- ============ ros2_control HARDWARE INTERFACE ============ -->
    <!-- This is the sim/real seam. In Gazebo the joints are backed by a
         simulator-provided system; on the real Hege the same controller sits on
         top of a hardware interface that talks to PX4, and neither the
         controller config nor Nav2 above it changes.

         The joint list below is shared by both Gazebo generations on purpose:
         only the hardware plugin name differs, so the two simulators cannot
         drift apart in which joints they expose or how they are commanded. -->
    <ros2_control name="HegeGazeboSystem" type="system">
      <hardware>
        <xacro:if value="${drive == 'ros2_control'}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:if value="${drive == 'gz'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
      </hardware>

      <!-- Rear wheels: traction, velocity commanded -->
      <joint name="left_rear_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_rear_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Front knuckles: steering, position commanded -->
      <joint name="left_steer_joint">
        <command_interface name="position">
          <param name="min">${-max_steer}</param>
          <param name="max">${max_steer}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_steer_joint">
        <command_interface name="position">
          <param name="min">${-max_steer}</param>
          <param name="max">${max_steer}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Front wheels just roll; nothing commands them. Declared state-only so
           joint_state_broadcaster reports them and robot_state_publisher can
           emit their TF - without this, left_front_wheel and right_front_wheel
           have no frame at all. -->
      <joint name="left_front_wheel_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_front_wheel_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <!-- ============ CONTROLLER MANAGER PLUGIN ============ -->
    <!-- The same controllers.yaml either way; only the host simulator's plugin
         name differs. -->
    <xacro:if value="${drive == 'ros2_control'}">
      <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <parameters>$(find hege_description)/config/controllers.yaml</parameters>
          <robot_param>robot_description</robot_param>
          <robot_param_node>robot_state_publisher</robot_param_node>
        </plugin>
      </gazebo>
    </xacro:if>

    <xacro:if value="${drive == 'gz'}">
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find hege_description)/config/controllers.yaml</parameters>
          <robot_param>robot_description</robot_param>
          <robot_param_node>robot_state_publisher</robot_param_node>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:if>

  <!-- ============ PX4 SITL (Gazebo Harmonic) ============ -->
  <!-- Nothing in this branch talks to ROS. PX4's gz_bridge reads the sensors
       and writes the joints straight over gz-transport, and everything ROS
       sees arrives later over uXRCE-DDS via hege_px4_sensors.

       PX4 finds the sensors by HARDCODED topic paths (GZBridge.cpp):

         /world/$W/model/$M/link/base_link/sensor/imu_sensor/imu
         /world/$W/model/$M/link/base_link/sensor/navsat_sensor/navsat
         /world/$W/model/$M/link/base_link/sensor/magnetometer_sensor/magnetometer
         /world/$W/model/$M/link/base_link/sensor/air_pressure_sensor/air_pressure

       So the link name and all four sensor names are fixed by PX4, not chosen
       by us. Renaming any of them silently gives a vehicle whose EKF2 never
       receives that sensor. -->
  <xacro:if value="${drive == 'px4'}">

    <!-- URDF->SDF conversion lumps a fixed joint's child into its parent.
         base_link is base_footprint's fixed child, so without this the model
         would have no link called base_link at all and PX4 would subscribe to
         four topics that never exist. -->
    <gazebo reference="base_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <!-- All four sensors live on base_link because PX4 demands it, and carry
         the measured lever arms as an explicit pose instead. imu_link and
         gps_link still exist in the URDF, so robot_state_publisher keeps
         publishing their TF for navsat_transform and RViz; they simply are not
         where the simulated hardware is mounted. -->
    <gazebo reference="base_link">

      <!-- 1.20 m above the ground = imu_z above base_link. -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 ${imu_z} 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- 1.30 m above the ground = gps_z above base_link. Deliberately
           noiseless: PX4 adds its own GNSS error model through the SIM_GPS_*
           parameters, and stacking ours on top would make the fix worse than
           either model describes. gps_noise in this file drives the Gazebo
           Classic receiver only. -->
      <sensor name="navsat_sensor" type="navsat">
        <pose>0 0 ${gps_z} 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>

      <!-- Neither sensor exists on the real Hege as a separate unit, but EKF2
           expects both. Noise figures are PX4's own, taken from the stock
           rover model: they describe the chips, not the vehicle. -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure>
        </air_pressure>
      </sensor>
    </gazebo>

    <!-- Traction: the two rear wheels.
         PX4 sends a gz Actuators message on command/motor_speed and the
         velocity it carries is (mixer output - 100), so the joint is commanded
         in rad/s directly. Both rear wheels read actuator 0, which is what
         makes them a single rigid axle rather than a differential.

         Hege is rear-wheel drive; PX4's own rover model drives all four. The
         front wheels below stay free-rolling, which is what the real machine
         does. -->
    <gazebo>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>left_rear_wheel_joint</joint_name>
        <sub_topic>command/motor_speed</sub_topic>
        <control_type>velocity</control_type>
        <use_actuator_msg>true</use_actuator_msg>
        <actuator_number>0</actuator_number>
      </plugin>
    </gazebo>
    <gazebo>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>right_rear_wheel_joint</joint_name>
        <sub_topic>command/motor_speed</sub_topic>
        <control_type>velocity</control_type>
        <use_actuator_msg>true</use_actuator_msg>
        <actuator_number>0</actuator_number>
      </plugin>
    </gazebo>

    <!-- Steering: both front knuckles.
         PX4 has one steering output, so both sides receive the same angle.
         That is parallel steering, not true Ackermann geometry - the inner and
         outer wheels should differ - but it is exactly what PX4's own rover
         model does, and the error is small at the turning radii this vehicle
         can reach. The gains are PX4's; raise them if the steering visibly
         lags the commanded angle on a 1300 kg vehicle. -->
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>left_steer_joint</joint_name>
        <sub_topic>servo_0</sub_topic>
        <p_gain>100</p_gain>
        <i_gain>10</i_gain>
        <d_gain>0</d_gain>
      </plugin>
    </gazebo>
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>right_steer_joint</joint_name>
        <sub_topic>servo_0</sub_topic>
        <p_gain>100</p_gain>
        <i_gain>10</i_gain>
        <d_gain>0</d_gain>
      </plugin>
    </gazebo>

    <!-- Publishes joint state on gz-transport only. It is not the ROS
         /joint_states topic and nothing in the ROS stack consumes it; it is
         here because it makes the model inspectable from `gz topic`. -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint_name>left_rear_wheel_joint</joint_name>
        <joint_name>right_rear_wheel_joint</joint_name>
        <joint_name>left_steer_joint</joint_name>
        <joint_name>right_steer_joint</joint_name>
        <joint_name>left_front_wheel_joint</joint_name>
        <joint_name>right_front_wheel_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
