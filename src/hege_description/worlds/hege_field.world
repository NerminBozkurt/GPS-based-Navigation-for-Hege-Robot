<?xml version="1.0"?>
<sdf version="1.6">
  <world name="hege_field">

    <!-- Anchors Gazebo's (0,0,0) to a real lat/lon. Without this the GPS
         sensor reports 0N 0E and navsat_transform has no sensible datum.
         Approximate ATB Fieldlab Marquardt (near Potsdam) - replace with the
         surveyed demo-site coordinates when they are known. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>52.466</latitude_deg>
      <longitude_deg>12.958</longitude_deg>
      <elevation>35.0</elevation>
      <!-- 180, not 0, and this is not a description of the site.
           Gazebo Classic's spherical-coordinate conversion mirrors the local
           frame: with heading_deg 0 the GPS sensor reported the exact negative
           of the model's true world position (measured ratio -1.006/-1.002 on
           both axes), so a rover driving to world x=+7.6 was reported as
           7.6 m WEST. heading_deg 180 cancels that rotation. Verified: world
           delta +7.609 now reads as GPS delta +7.595 east.
           Recheck this if the Gazebo version changes - if the upstream bug is
           ever fixed, this line becomes the bug. -->
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <include><uri>model://sun</uri></include>
    
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>12.0 -12.0 16.0 0 0.75 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- 1. Płaska, nieskończona baza podłoża (gwarancja: traktor NIGDY nie spadnie w próżnię) -->
    <model name="infinite_ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>100.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.38 0.28 1</ambient>
            <diffuse>0.45 0.38 0.28 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.525 0 0 0</pose>
    </model>

    <!-- 2. Zrównoważony, płynny teren rolniczy o powierzchni 300m x 300m i wysokiej przyczepności -->
    <model name="bumpy_field">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>file:///workspace/src/hege_description/worlds/field_heightmap.pgm</uri>
              <size>300 300 0.04</size>
              <pos>0 0 -0.52</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>100.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <texture>
                <diffuse>file://media/materials/textures/dirt_diffusespecular.png</diffuse>
                <normal>file://media/materials/textures/flat_normal.png</normal>
                <size>3</size>
              </texture>
              <uri>file:///workspace/src/hege_description/worlds/field_heightmap.pgm</uri>
              <size>300 300 0.04</size>
              <pos>0 0 -0.52</pos>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- 4 LEŻĄCE BELE SIANA ROZMIESZCZONE NATURALNIE NA POLU               -->
    <!-- Zoptymalizowana, płynna trasa zbioru beli po gładkich łukach       -->
    <!-- ================================================================= -->

    <!-- BELA 1: X=16.0, Y=-4.0, Płynny najazd z pozycji startowej (Yaw=-0.15 rad / -8.6 deg) -->
    <model name="hay_bale_1">
      <static>true</static>
      <pose>16.0 -4.0 -0.50 0 0 -0.15</pose>
      <link name="link">
        <!-- 1. Leżący walec siana -->
        <visual name="bale_visual">
          <pose>0 0 0.6 0 1.570796 0</pose>
          <geometry>
            <cylinder><radius>0.6</radius><length>1.3</length></cylinder>
          </geometry>
          <material>
            <ambient>0.92 0.78 0.25 1</ambient>
            <diffuse>0.92 0.78 0.25 1</diffuse>
            <emissive>0.25 0.18 0.02 1</emissive>
          </material>
        </visual>
        <!-- 2. Jaskrawa zielona strzałka 3D najazdu na ziemi (start od -3.2m do -0.2m) -->
        <visual name="arrow_shaft">
          <pose>-1.9 0 0.125 0 0 0</pose>
          <geometry><box><size>2.6 0.45 0.25</size></box></geometry>
          <material>
            <ambient>0 1 0.2 1</ambient>
            <diffuse>0 1 0.2 1</diffuse>
            <emissive>0 0.9 0.2 1</emissive>
          </material>
        </visual>
        <visual name="arrow_head">
          <pose>-0.45 0 0.125 0 0 0</pose>
          <geometry><box><size>0.6 1.0 0.25</size></box></geometry>
          <material>
            <ambient>0 1 0.2 1</ambient>
            <diffuse>0 1 0.2 1</diffuse>
            <emissive>0 0.9 0.2 1</emissive>
          </material>
        </visual>
        <!-- 3. Wysoki maszt ze świecącym punktem (widoczny z daleka) -->
        <visual name="flag_pole">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>2.4</length></cylinder></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="beacon">
          <pose>0 0 2.4 0 0 0</pose>
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material>
            <ambient>1 0.7 0 1</ambient>
            <diffuse>1 0.7 0 1</diffuse>
            <emissive>1 0.7 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- BELA 2: X=28.0, Y=8.0, Płynny najazd po łuku (Yaw=0.75 rad / 43.0 deg) -->
    <model name="hay_bale_2">
      <static>true</static>
      <pose>28.0 8.0 -0.50 0 0 0.75</pose>
      <link name="link">
        <visual name="bale_visual">
          <pose>0 0 0.6 0 1.570796 0</pose>
          <geometry>
            <cylinder><radius>0.6</radius><length>1.3</length></cylinder>
          </geometry>
          <material>
            <ambient>0.92 0.78 0.25 1</ambient>
            <diffuse>0.92 0.78 0.25 1</diffuse>
            <emissive>0.25 0.18 0.02 1</emissive>
          </material>
        </visual>
        <visual name="arrow_shaft">
          <pose>-1.9 0 0.125 0 0 0</pose>
          <geometry><box><size>2.6 0.45 0.25</size></box></geometry>
          <material>
            <ambient>0 1 0.2 1</ambient>
            <diffuse>0 1 0.2 1</diffuse>
            <emissive>0 0.9 0.2 1</emissive>
          </material>
        </visual>
        <visual name="arrow_head">
          <pose>-0.45 0 0.125 0 0 0</pose>
          <geometry><box><size>0.6 1.0 0.25</size></box></geometry>
          <material>
            <ambient>0 1 0.2 1</ambient>
            <diffuse>0 1 0.2 1</diffuse>
            <emissive>0 0.9 0.2 1</emissive>
          </material>
        </visual>
        <visual name="flag_pole">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>2.4</length></cylinder></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="beacon">
          <pose>0 0 2.4 0 0 0</pose>
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material>
            <ambient>1 0.7 0 1</ambient>
            <diffuse>1 0.7 0 1</diffuse>
            <emissive>1 0.7 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- BELA 3: X=14.0, Y=22.0, Płynny skręt w lewo (Yaw=2.35 rad / 134.6 deg) -->
    <model name="hay_bale_3">
      <static>true</static>
      <pose>14.0 22.0 -0.50 0 0 2.35</pose>
      <link name="link">
        <visual name="bale_visual">
          <pose>0 0 0.6 0 1.570796 0</pose>
          <geometry>
            <cylinder><radius>0.6</radius><length>1.3</length></cylinder>
          </geometry>
          <material>
            <ambient>0.92 0.78 0.25 1</ambient>
            <diffuse>0.92 0.78 0.25 1</diffuse>
            <emissive>0.25 0.18 0.02 1</emissive>
          </material>
        </visual>
        <visual name="arrow_shaft">
          <pose>-1.9 0 0.125 0 0 0</pose>
          <geometry><box><size>2.6 0.45 0.25</size></box></geometry>
          <material>
            <ambient>0 1 0.2 1</ambient>
            <diffuse>0 1 0.2 1</diffuse>
            <emissive>0 0.9 0.2 1</emissive>
          </material>
        </visual>
        <visual name="arrow_head">
          <pose>-0.45 0 0.125 0 0 0</pose>
          <geometry><box><size>0.6 1.0 0.25</size></box></geometry>
          <material>
            <ambient>0 1 0.2 1</ambient>
            <diffuse>0 1 0.2 1</diffuse>
            <emissive>0 0.9 0.2 1</emissive>
          </material>
        </visual>
        <visual name="flag_pole">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>2.4</length></cylinder></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="beacon">
          <pose>0 0 2.4 0 0 0</pose>
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material>
            <ambient>1 0.7 0 1</ambient>
            <diffuse>1 0.7 0 1</diffuse>
            <emissive>1 0.7 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- BELA 4: X=-2.0, Y=10.0, Płynny przejazd w kierunku bazy (Yaw=-2.55 rad / -146.1 deg) -->
    <model name="hay_bale_4">
      <static>true</static>
      <pose>-2.0 10.0 -0.50 0 0 -2.55</pose>
      <link name="link">
        <visual name="bale_visual">
          <pose>0 0 0.6 0 1.570796 0</pose>
          <geometry>
            <cylinder><radius>0.6</radius><length>1.3</length></cylinder>
          </geometry>
          <material>
            <ambient>0.92 0.78 0.25 1</ambient>
            <diffuse>0.92 0.78 0.25 1</diffuse>
            <emissive>0.25 0.18 0.02 1</emissive>
          </material>
        </visual>
        <visual name="arrow_shaft">
          <pose>-1.9 0 0.125 0 0 0</pose>
          <geometry><box><size>2.6 0.45 0.25</size></box></geometry>
          <material>
            <ambient>0 1 0.2 1</ambient>
            <diffuse>0 1 0.2 1</diffuse>
            <emissive>0 0.9 0.2 1</emissive>
          </material>
        </visual>
        <visual name="arrow_head">
          <pose>-0.45 0 0.125 0 0 0</pose>
          <geometry><box><size>0.6 1.0 0.25</size></box></geometry>
          <material>
            <ambient>0 1 0.2 1</ambient>
            <diffuse>0 1 0.2 1</diffuse>
            <emissive>0 0.9 0.2 1</emissive>
          </material>
        </visual>
        <visual name="flag_pole">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>2.4</length></cylinder></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="beacon">
          <pose>0 0 2.4 0 0 0</pose>
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material>
            <ambient>1 0.7 0 1</ambient>
            <diffuse>1 0.7 0 1</diffuse>
            <emissive>1 0.7 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Ground truth for evaluation only. Publishes every model's exact pose
         on /model_states with no noise. Nothing in the navigation stack may
         consume this - it exists so the estimates can be scored against the
         real answer. Preferred over gazebo_ros_p3d, whose reported position
         came out sign-flipped relative to its own reported orientation. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <shadows>true</shadows>
    </scene>

  </world>
</sdf>
