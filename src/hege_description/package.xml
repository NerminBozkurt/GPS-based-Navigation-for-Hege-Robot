<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hege_description</name>
  <version>0.0.0</version>
  <description>URDF, worlds and Gazebo bringup for the Hege Ackermann field robot.</description>
  <maintainer email="bozkurtnrmn@gmail.com">nermin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <depend>xacro</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ackermann_steering_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- NEITHER Gazebo generation is declared here, and that is deliberate.
       rosdep would resolve each name to the wrong thing and then uninstall
       what is already working:

         ros_gz_sim, ros_gz_bridge, gz_ros2_control  ->  the ROS 2 Humble
           binaries, which are built against Gazebo FORTRESS. Humble's official
           Gazebo pairing is Fortress, not Harmonic. Installing them next to
           Harmonic pulls in a second, conflicting Gazebo.

         gazebo_ros, gazebo_plugins, gazebo_ros2_control  ->  Gazebo CLASSIC,
           which conflicts with Harmonic outright: both ship /usr/bin/gz, so
           apt removes one to install the other.

       docs/gazebo_harmonic.md says what to install for each path and why it
       has to be done by hand. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
