<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hege_description</name>
  <version>0.0.0</version>
  <description>URDF, worlds and Gazebo bringup for the Hege Ackermann field robot.</description>
  <maintainer email="bozkurtnrmn@gmail.com">nermin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <depend>xacro</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ackermann_steering_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- Gazebo CLASSIC, which is what spawn_hege.launch.py uses and what the
       navigation tuning was measured against. -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>

  <!-- Gazebo HARMONIC, for spawn_hege_gz.launch.py, is deliberately NOT
       declared, even though that launch file needs ros_gz_sim, ros_gz_bridge
       and gz_ros2_control. Two reasons, and both of them bite silently:

         - Harmonic conflicts with Classic outright. Both ship /usr/bin/gz, so
           `rosdep install` on a Classic machine would apt-remove the whole
           Classic stack to satisfy the Harmonic names, which is exactly the
           accident this comment exists to prevent.
         - Those three names resolve to the ROS 2 Humble binaries, which are
           built against Gazebo FORTRESS - Humble's official pairing - not
           Harmonic. `ros-humble-gz-ros2-control` depends on libsdformat12,
           where Harmonic is libsdformat14.

       docs/gazebo_harmonic.md says what to install for the Harmonic path and
       why it has to be done by hand. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
